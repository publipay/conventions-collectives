# Convention collective nationale de l'industrie et des services nautiques du 13 octobre 2020
# (IDCC 3236, brochure 3410).
# Version 2026.1 : avenant du 10 juillet 2026 relatif aux salaires minima mensuels,
# applicable au 1er juin 2026, sur les mêmes niveaux et échelons que la version 2025.2.
validFrom: 2026-06-01
extension: 2026-09-30
sources:
  - >-
    Avenant du 10 juillet 2026 relatif aux salaires minima mensuels au 1er juin 2026
    (KALITEXT000055051420), article 1er : « À partir du 1er juin 2026, les rémunérations
    minimales, base 151,67 heures, pour un horaire hebdomadaire de travail effectif de 35 heures »,
    tableaux des ouvriers et employés (I.1 à III.3), des techniciens (IV), des techniciens et agents
    de maîtrise (V et VI) et des ingénieurs et cadres (VII.1 à VII.4), de 1 867,02 € à 5 128,67 €.
    Étendu par arrêté du 22 septembre 2026 (JORF du 30 septembre 2026). Texte lu par l'API
    Légifrance le 14 novembre 2026 :
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000055051420
  - >-
    Convention collective nationale de l'industrie et des services nautiques
    du 13 octobre 2020, IDCC 3236, publiée sur Légifrance.
    https://www.legifrance.gouv.fr/conv_coll/id/KALICONT000043157451
---
salarié . convention collective . industrie services nautiques:
  titre: Industrie et services nautiques (IDCC 3236)
  valeur: convention collective = 'industrie services nautiques'

salarié . convention collective . industrie services nautiques . niveau et échelon:
  titre: Niveau et échelon conventionnels
  description: Référence de la grille de l'avenant du 10 juillet 2026, par exemple I.1 ou VI.2.
  applicable si: convention collective = 'industrie services nautiques'
  par défaut: "'non renseigné'"

salarié . convention collective . industrie services nautiques . grille:
  titre: Salaire minimum mensuel conventionnel à temps plein
  description: Valeurs mensuelles minimales de l'annexe de l'avenant du 10 juillet 2026.
  applicable si: convention collective = 'industrie services nautiques'
  unité: €/mois
  variations:
    - si: niveau et échelon = 'I.1'
      alors: 1867.02 €/mois
    - si: niveau et échelon = 'I.2'
      alors: 1880.92 €/mois
    - si: niveau et échelon = 'II.1'
      alors: 1895.23 €/mois
    - si: niveau et échelon = 'II.2'
      alors: 1910.19 €/mois
    - si: niveau et échelon = 'II.3'
      alors: 1930.70 €/mois
    - si: niveau et échelon = 'III.1'
      alors: 1953.75 €/mois
    - si: niveau et échelon = 'III.2'
      alors: 1975.64 €/mois
    - si: niveau et échelon = 'III.3'
      alors: 1996.58 €/mois
    - si: niveau et échelon = 'IV.1'
      alors: 1998.54 €/mois
    - si: niveau et échelon = 'IV.2'
      alors: 2012.21 €/mois
    - si: niveau et échelon = 'V.1'
      alors: 2033.17 €/mois
    - si: niveau et échelon = 'V.2'
      alors: 2131.99 €/mois
    - si: niveau et échelon = 'VI.1'
      alors: 2308.84 €/mois
    - si: niveau et échelon = 'VI.2'
      alors: 2507.61 €/mois
    - si: niveau et échelon = 'VII.1'
      alors: 2355.32 €/mois
    - si: niveau et échelon = 'VII.2'
      alors: 2570.62 €/mois
    - si: niveau et échelon = 'VII.3'
      alors: 3685.55 €/mois
    - si: niveau et échelon = 'VII.4'
      alors: 5128.67 €/mois
    - sinon: 0 €/mois

salarié . convention collective . industrie services nautiques . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Minimum mensuel brut à temps plein, proratisé selon la quotité de travail.
  applicable si: convention collective = 'industrie services nautiques'
  unité: €/mois
  valeur: grille * contrat . temps de travail . quotité

salarié . convention collective . industrie services nautiques . niveau et échelon hors grille:
  titre: Niveau et échelon absent de la grille
  description: La classification ne figure pas dans la grille de l'avenant du 10 juillet 2026.
  applicable si: convention collective = 'industrie services nautiques'
  valeur: grille = 0 €/mois
