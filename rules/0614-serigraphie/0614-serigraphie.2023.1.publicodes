# Industries de la sérigraphie et procédés d'impression numérique connexes (IDCC 614).
# Version 2023.1 : Salaires mensuels minima de l'accord du 21 juin 2023 ; les positions A et B sont sous le SMIC de 2026.
validFrom: 2023-09-01
extension: 2023-09-22
sources:
  - >-
    Accord du 21 juin 2023 relatif aux salaires mensuels minima conventionnels, applicable à compter du 1er septembre 2023, étendu par arrêté du 4 septembre 2023 (JORF du 22 septembre 2023). Aucun accord de salaires postérieur n'est publié sur Légifrance au 2 novembre 2026.
  - >-
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000048052361
  - >-
    Convention collective nationale des industries de la sérigraphie et des procédés d'impression numérique connexes du 23 mars 1971, conteneur KALICONT000005635648.
---
salarié . convention collective . sérigraphie:
  titre: Industries de la sérigraphie et procédés d'impression numérique connexes (IDCC 614)
  valeur: convention collective = 'sérigraphie'

salarié . convention collective . sérigraphie . position:
  titre: Position
  description: >-
    Position A à I de la grille des salaires mensuels minima.
  applicable si: convention collective = 'sérigraphie'
  par défaut: "'non renseigné'"

salarié . convention collective . sérigraphie . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Minimum brut à temps plein de la grille, proratisé selon la quotité de travail.
  applicable si: convention collective = 'sérigraphie'
  unité: €/mois
  valeur: grille * contrat . temps de travail . quotité

salarié . convention collective . sérigraphie . salaire minimum conventionnel . grille:
  titre: Minimum brut à temps plein
  unité: €/mois
  variations:
    - si: position = 'A'
      alors: 1747.20 €/mois
    - si: position = 'B'
      alors: 1783.74 €/mois
    - si: position = 'C'
      alors: 1850.18 €/mois
    - si: position = 'D'
      alors: 1994.31 €/mois
    - si: position = 'E'
      alors: 2196.71 €/mois
    - si: position = 'F'
      alors: 2439.99 €/mois
    - si: position = 'G'
      alors: 2674.08 €/mois
    - si: position = 'H'
      alors: 3165.75 €/mois
    - si: position = 'I'
      alors: 3769.87 €/mois
    - sinon: 0 €/mois

salarié . convention collective . sérigraphie . position hors grille:
  titre: Classification absente de la grille
  applicable si: convention collective = 'sérigraphie'
  valeur: salaire minimum conventionnel . grille = 0 €/mois
