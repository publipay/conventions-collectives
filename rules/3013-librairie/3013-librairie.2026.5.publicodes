# Convention collective nationale de la librairie du 24 mars 2011 (IDCC 3013).
#
# Version 2026.3 replaces 2026.2 for the same effective date (1 April 2026): the grid of 2026.1 and 2026.2
# did not match the extended accord of 25 November 2025. A released version is immutable.

# Révision 2026.4 : ajoute à la version 2026.3, à dates d'effet identiques, la cotisation au
# fonds de développement du paritarisme (0,05 % des salaires).
# Révision 2026.5 : ajoute à la version 2026.4, à dates d'effet identiques, la contribution
# conventionnelle de formation professionnelle (0,1 % de la masse salariale de 10 à 299
# salariés).
validFrom: 2026-04-01
sources:
  - >-
    Accord du 25 novembre 2025 relatif aux salaires minima et à la prime d'ancienneté, IDCC 3013,
    conteneur KALICONT000027180935, article 3 (barème des rémunérations minimum mensuelles brutes garanties
    des niveaux 1 à 12, pour 151,67 heures en moyenne). Étendu par arrêté du 24 février 2026, JORF du 5 mars 2026.
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000054034034
  - >-
    Article 7 de l'accord : entrée en vigueur le 1er jour du mois suivant la publication de l'arrêté d'extension
    (publié avant le 15e jour du mois), soit le 1er avril 2026.
  - >-
    Les versions 2026.1 et 2026.2 citaient à tort un « avenant n° 14 du 5 novembre 2025 » (KALITEXT000053926509,
    sans contenu sur Légifrance) et une grille inexacte pour les niveaux 2 à 7 et 9 à 12.
    La prime d'ancienneté des articles 4.1 et 4.2 n'est pas modélisée.
  - >-
    Accord du 5 décembre 2005 relatif au développement du paritarisme (KALITEXT000018878622),
    étendu par arrêté du 23 mars 2006 (JORF du 7 avril 2006) : cotisation annuelle à la charge
    des entreprises, « Le taux de cette cotisation est fixé à 0,05 % du montant des salaires
    entrant dans l'assiette des cotisations de sécurité sociale ». Texte lu sur Légifrance le 8
    novembre 2026 : https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000018878622
  - >-
    Accord du 16 septembre 2015 relatif à la formation professionnelle (KALITEXT000032003321),
    étendu par arrêté du 23 février 2016 (JORF du 26 février 2016), conclu pour une durée
    indéterminée : « Cette contribution de 0,1 % de la masse salariale est versée par les
    employeurs de 10 à 299 salariés à l'OPCA désigné par la branche », mutualisée dans une
    section comptable à part. Texte lu sur Légifrance le 9 novembre 2026 :
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000032003321
---
salarié . convention collective . librairie:
  titre: Librairie (IDCC 3013)
  valeur: convention collective = 'librairie'

salarié . convention collective . librairie . niveau:
  titre: Niveau de classification
  description: Niveau 1 à 12 de la grille des salaires minima conventionnels.
  applicable si: convention collective = 'librairie'
  par défaut: "'non renseigné'"

salarié . convention collective . librairie . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Minimum mensuel brut à temps plein, proratisé selon la quotité de travail.
  applicable si: convention collective = 'librairie'
  unité: €/mois
  valeur: grille * contrat . temps de travail . quotité

salarié . convention collective . librairie . salaire minimum conventionnel . grille:
  titre: Grille mensuelle à temps plein
  unité: €/mois
  variations:
    - si: niveau = '1'
      alors: 1834 €/mois
    - si: niveau = '2'
      alors: 1848 €/mois
    - si: niveau = '3'
      alors: 1862 €/mois
    - si: niveau = '4'
      alors: 1876 €/mois
    - si: niveau = '5'
      alors: 1952 €/mois
    - si: niveau = '6'
      alors: 2037 €/mois
    - si: niveau = '7'
      alors: 2209 €/mois
    - si: niveau = '8'
      alors: 2426 €/mois
    - si: niveau = '9'
      alors: 2635 €/mois
    - si: niveau = '10'
      alors: 3175 €/mois
    - si: niveau = '11'
      alors: 3620 €/mois
    - si: niveau = '12'
      alors: 3965 €/mois
    - sinon: 0 €/mois

salarié . convention collective . librairie . niveau hors grille:
  titre: Niveau absent de la grille
  description: Le niveau n'existe pas dans la grille des salaires minima.
  applicable si: convention collective = 'librairie'
  valeur: salaire minimum conventionnel . grille = 0 €/mois

salarié . convention collective . librairie . financement du paritarisme:
  titre: Cotisation au fonds de développement du paritarisme
  description: |
    Cotisation des entreprises au fonds de développement du paritarisme : 0,05 % des salaires
    soumis à cotisations (accord du 5 décembre 2005). Le montant mensuel est une provision :
    0,05 % du brut du mois.
  applicable si: convention collective = 'librairie'
  unité: €/mois
  produit:
    - cotisations . assiette
    - 0.05%

salarié . convention collective . librairie . cotisations employeur avec paritarisme:
  applicable si: convention collective = 'librairie'
  remplace: salarié . cotisations . employeur
  somme:
    - salarié . cotisations . employeur
    - financement du paritarisme
    - formation professionnelle conventionnelle

salarié . convention collective . librairie . formation professionnelle conventionnelle:
  titre: Contribution conventionnelle de formation professionnelle
  description: |
    Contribution conventionnelle de formation professionnelle des employeurs de 10 à 299
    salariés : 0,1 % de la masse salariale (accord du 16 septembre 2015). Le montant mensuel est
    une provision : 0,1 % du brut du mois.
  applicable si: convention collective = 'librairie'
  unité: €/mois
  produit:
    - cotisations . assiette
    - taux

salarié . convention collective . librairie . formation professionnelle conventionnelle . taux:
  variations:
    - si: entreprise . salariés . effectif >= 300
      alors: 0%
    - si: entreprise . salariés . effectif >= 10
      alors: 0.1%
    - sinon: 0%
