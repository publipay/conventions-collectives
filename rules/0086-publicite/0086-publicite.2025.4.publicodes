# Révision 2025.4 : ajoute à la version 2025.3, à dates d'effet identiques, la contribution
# proportionnelle au financement du paritarisme (0,03 % de la masse salariale brute).
validFrom: '2025-06-19'
sources:
  - https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000051910235
  - https://www.legifrance.gouv.fr/conv_coll/article/KALIARTI000051910239
  - https://www.legifrance.gouv.fr/conv_coll/article/KALIARTI000051910251
  - https://www.legifrance.gouv.fr/jorf/id/JORFTEXT000051760692
  - https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000005678091
  - https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000005678101
  - https://echanges.dila.gouv.fr/OPENDATA/KALI/
  - >-
    Avenant n° 1 du 16 novembre 2018 à l'accord du 18 avril 2013 relatif au financement du
    paritarisme (KALITEXT000038418066), étendu par arrêté du 3 avril 2020 (JORF du 9 avril 2020)
    : contribution annuelle globale due par toutes les entreprises, quel que soit leur effectif,
    composée « d'une contribution forfaitaire annuelle de 25 € par entreprise » et « d'une
    contribution proportionnelle fixée à 0,03 % de la masse salariale brute totale déclarée en
    retraite complémentaire ». Le forfait par entreprise n'est pas calculé. Texte lu sur
    Légifrance le 8 novembre 2026 :
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000038418066
---
salarié . convention collective . publicité:
  titre: Entreprises de publicité (IDCC 86)
  valeur: convention collective = 'publicité'

salarié . convention collective . publicité . catégorie:
  titre: Catégorie professionnelle
  description: Catégorie conventionnelle réellement attribuée selon la classification de l'entreprise. Le modèle ne déduit pas la catégorie de l'intitulé du poste.
  applicable si: convention collective = 'publicité'
  par défaut: "'non renseignée'"

salarié . convention collective . publicité . niveau:
  titre: Niveau de classification
  description: Niveau conventionnel de 1 à 4 au sein de la catégorie retenue.
  applicable si: convention collective = 'publicité'
  par défaut: "'non renseigné'"

salarié . convention collective . publicité . salaire minimum conventionnel:
  titre: Salaire minimum conventionnel mensuel
  description: Minimum mensuel brut à temps plein de l'accord salarial étendu du 19 février 2025, applicable à compter du 1er juillet 2025. Le montant est proratisé selon la quotité de travail.
  applicable si:
    toutes ces conditions:
      - convention collective = 'publicité'
      - grille mensuelle > 0 €/mois
  unité: €/mois
  arrondi: 2 décimales
  valeur: grille mensuelle * contrat . temps de travail . quotité

salarié . convention collective . publicité . grille mensuelle:
  applicable si: convention collective = 'publicité'
  unité: €/mois
  variations:
    - si: catégorie = 'employés'
      alors:
        variations:
          - si: niveau = '1'
            alors: 1842 €/mois
          - si: niveau = '2'
            alors: 1858 €/mois
          - si: niveau = '3'
            alors: 1876 €/mois
          - si: niveau = '4'
            alors: 1957 €/mois
          - sinon: 0 €/mois
    - si: catégorie = 'techniciens'
      alors:
        variations:
          - si: niveau = '1'
            alors: 1999 €/mois
          - si: niveau = '2'
            alors: 2058 €/mois
          - si: niveau = '3'
            alors: 2124 €/mois
          - si: niveau = '4'
            alors: 2252 €/mois
          - sinon: 0 €/mois
    - si: catégorie = 'cadres'
      alors:
        variations:
          - si: niveau = '1'
            alors: 2448 €/mois
          - si: niveau = '2'
            alors: 2684 €/mois
          - si: niveau = '3'
            alors: 3164 €/mois
          - si: niveau = '4'
            alors: 4142 €/mois
          - sinon: 0 €/mois
    - sinon: 0 €/mois

salarié . convention collective . publicité . niveau hors grille:
  applicable si: convention collective = 'publicité'
  valeur: grille mensuelle = 0 €/mois

salarié . convention collective . publicité . cotisations:
  applicable si: convention collective = 'publicité'
  valeur: oui

salarié . convention collective . publicité . cotisations . formation professionnelle:
  applicable si: convention collective = 'publicité'
  remplace: salarié . cotisations . formation professionnelle
  somme:
    - salarié . cotisations . formation professionnelle
    - contribution conventionnelle

salarié . convention collective . publicité . cotisations . formation professionnelle . contribution conventionnelle:
  applicable si: convention collective = 'publicité'
  description: Contribution conventionnelle complémentaire de 0,30 % de l'assiette des cotisations, prévue par l'accord de branche de la publicité relatif à la formation professionnelle.
  valeur: salarié . cotisations . assiette * 0.30%

salarié . convention collective . publicité . financement du paritarisme:
  titre: Contribution au financement du paritarisme
  description: |
    Contribution proportionnelle des entreprises au financement du paritarisme : 0,03 % de la
    masse salariale brute déclarée en retraite complémentaire (avenant n° 1 du 16 novembre
    2018). Le forfait annuel de 25 € par entreprise n'est pas calculé ; le montant mensuel est
    une provision : 0,03 % du brut du mois.
  applicable si: convention collective = 'publicité'
  unité: €/mois
  produit:
    - cotisations . assiette
    - 0.03%

salarié . convention collective . publicité . cotisations employeur avec paritarisme:
  applicable si: convention collective = 'publicité'
  remplace: salarié . cotisations . employeur
  somme:
    - salarié . cotisations . employeur
    - financement du paritarisme
