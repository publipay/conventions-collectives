# Éditeurs de la presse magazine, employés et cadres (IDCC 3225).
# Version 2024.1 : barèmes de l'accord du 17 juin 2024, au 1er juillet 2024.
validFrom: 2024-07-01
extension: 2024-09-12
sources:
  - >-
    Accord du 17 juin 2024 relatif aux barèmes de salaires minima garantis, articles 1er et 3 et annexe : salaires mensuels bruts minima des groupes 1 à 5 (employés) et 6 à 9 (cadres) pour 151,67 heures, à l'engagement et après 3, 6 et 10 ans d'ancienneté dans l'entreprise, au 1er juillet 2024, étendu par arrêté du 4 septembre 2024 (JORF du 12 septembre 2024).
  - >-
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000050298949
---
salarié . convention collective . presse magazine:
  titre: Éditeurs de la presse magazine, employés et cadres (IDCC 3225)
  valeur: convention collective = 'presse magazine'

salarié . convention collective . presse magazine . groupe:
  titre: Groupe de classification
  description: Groupes 1 à 5 pour les employés, 6 à 9 pour les cadres.
  applicable si: convention collective = 'presse magazine'
  unité: unité
  par défaut: 0

salarié . convention collective . presse magazine . ancienneté dans l'entreprise:
  titre: Ancienneté dans l'entreprise
  description: Ancienneté retenue par le barème, avec des paliers à 3, 6 et 10 ans.
  applicable si: convention collective = 'presse magazine'
  unité: an
  par défaut: 0 an

salarié . convention collective . presse magazine . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Minimum brut à temps plein du barème, proratisé selon la quotité de travail.
  applicable si: convention collective = 'presse magazine'
  unité: €/mois
  valeur: barème * contrat . temps de travail . quotité

salarié . convention collective . presse magazine . barème:
  titre: Minimum brut à temps plein
  applicable si: convention collective = 'presse magazine'
  unité: €/mois
  variations:
    - si: groupe = 1
      alors:
        variations:
          - si: ancienneté dans l'entreprise >= 10 an
            alors: 1990.91 €/mois
          - si: ancienneté dans l'entreprise >= 6 an
            alors: 1918.51 €/mois
          - si: ancienneté dans l'entreprise >= 3 an
            alors: 1864.21 €/mois
          - sinon: 1809.92 €/mois
    - si: groupe = 2
      alors:
        variations:
          - si: ancienneté dans l'entreprise >= 10 an
            alors: 1990.91 €/mois
          - si: ancienneté dans l'entreprise >= 6 an
            alors: 1918.51 €/mois
          - si: ancienneté dans l'entreprise >= 3 an
            alors: 1864.21 €/mois
          - sinon: 1809.92 €/mois
    - si: groupe = 3
      alors:
        variations:
          - si: ancienneté dans l'entreprise >= 10 an
            alors: 2113.56 €/mois
          - si: ancienneté dans l'entreprise >= 6 an
            alors: 2036.70 €/mois
          - si: ancienneté dans l'entreprise >= 3 an
            alors: 1979.06 €/mois
          - sinon: 1921.41 €/mois
    - si: groupe = 4
      alors:
        variations:
          - si: ancienneté dans l'entreprise >= 10 an
            alors: 2259.33 €/mois
          - si: ancienneté dans l'entreprise >= 6 an
            alors: 2177.17 €/mois
          - si: ancienneté dans l'entreprise >= 3 an
            alors: 2115.55 €/mois
          - sinon: 2053.93 €/mois
    - si: groupe = 5
      alors:
        variations:
          - si: ancienneté dans l'entreprise >= 10 an
            alors: 2459.75 €/mois
          - si: ancienneté dans l'entreprise >= 6 an
            alors: 2370.30 €/mois
          - si: ancienneté dans l'entreprise >= 3 an
            alors: 2303.22 €/mois
          - sinon: 2236.13 €/mois
    - si: groupe = 6
      alors:
        variations:
          - si: ancienneté dans l'entreprise >= 10 an
            alors: 2644.22 €/mois
          - si: ancienneté dans l'entreprise >= 6 an
            alors: 2548.07 €/mois
          - si: ancienneté dans l'entreprise >= 3 an
            alors: 2475.96 €/mois
          - sinon: 2403.84 €/mois
    - si: groupe = 7
      alors:
        variations:
          - si: ancienneté dans l'entreprise >= 10 an
            alors: 2987.97 €/mois
          - si: ancienneté dans l'entreprise >= 6 an
            alors: 2879.32 €/mois
          - si: ancienneté dans l'entreprise >= 3 an
            alors: 2797.83 €/mois
          - sinon: 2716.34 €/mois
    - si: groupe = 8
      alors:
        variations:
          - si: ancienneté dans l'entreprise >= 10 an
            alors: 3483.77 €/mois
          - si: ancienneté dans l'entreprise >= 6 an
            alors: 3357.09 €/mois
          - si: ancienneté dans l'entreprise >= 3 an
            alors: 3262.08 €/mois
          - sinon: 3167.07 €/mois
    - si: groupe = 9
      alors:
        variations:
          - si: ancienneté dans l'entreprise >= 10 an
            alors: 3839.56 €/mois
          - si: ancienneté dans l'entreprise >= 6 an
            alors: 3699.94 €/mois
          - si: ancienneté dans l'entreprise >= 3 an
            alors: 3595.22 €/mois
          - sinon: 3490.51 €/mois
    - sinon: 0 €/mois

salarié . convention collective . presse magazine . groupe hors grille:
  titre: Groupe absent du barème
  applicable si: convention collective = 'presse magazine'
  valeur: barème = 0 €/mois
