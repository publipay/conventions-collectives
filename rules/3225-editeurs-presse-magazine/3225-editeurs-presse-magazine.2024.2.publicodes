# Éditeurs de la presse magazine, employés et cadres (IDCC 3225).
# Version 2024.1 : barèmes de l'accord du 17 juin 2024, au 1er juillet 2024.
# Révision 2024.2 : ajoute à la version 2024.1, à dates d'effet identiques, la contribution
# conventionnelle mutualisée de formation professionnelle (0,1 % des salaires de 11 à 49
# salariés, 0,4 % à partir de 50, de 2026 à 2028).
validFrom: 2024-07-01
extension: 2024-09-12
sources:
  - >-
    Accord du 17 juin 2024 relatif aux barèmes de salaires minima garantis, articles 1er et 3 et annexe : salaires mensuels bruts minima des groupes 1 à 5 (employés) et 6 à 9 (cadres) pour 151,67 heures, à l'engagement et après 3, 6 et 10 ans d'ancienneté dans l'entreprise, au 1er juillet 2024, étendu par arrêté du 4 septembre 2024 (JORF du 12 septembre 2024).
  - >-
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000050298949
  - >-
    Accord du 8 décembre 2025 relatif à la formation professionnelle (KALITEXT000053721776),
    conclu pour une durée de trois ans, soit pour les années 2026, 2027 et 2028 : article 9,
    contribution conventionnelle mutualisée que les entreprises de 11 salariés et plus versent
    chaque année pendant la durée de l'accord, « 0,1 % du montant des salaires bruts versé aux
    salariés en CDI et aux salariés en CDD pour les entreprises de 11 à 49 salariés ; 0,4 %
    [...] pour les entreprises de 50 salariés et plus », versée à l'Afdas. L'accord précédent du
    21 novembre 2022 (KALITEXT000047348255), aux mêmes taux, couvrait 2023 à 2025 et n'est pas
    ajouté pour ces années. Texte lu sur Légifrance le 9 novembre 2026 :
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000053721776
---
salarié . convention collective . presse magazine:
  titre: Éditeurs de la presse magazine, employés et cadres (IDCC 3225)
  valeur: convention collective = 'presse magazine'

salarié . convention collective . presse magazine . groupe:
  titre: Groupe de classification
  description: Groupes 1 à 5 pour les employés, 6 à 9 pour les cadres.
  applicable si: convention collective = 'presse magazine'
  unité: unité
  par défaut: 0

salarié . convention collective . presse magazine . ancienneté dans l'entreprise:
  titre: Ancienneté dans l'entreprise
  description: Ancienneté retenue par le barème, avec des paliers à 3, 6 et 10 ans.
  applicable si: convention collective = 'presse magazine'
  unité: an
  par défaut: 0 an

salarié . convention collective . presse magazine . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Minimum brut à temps plein du barème, proratisé selon la quotité de travail.
  applicable si: convention collective = 'presse magazine'
  unité: €/mois
  valeur: barème * contrat . temps de travail . quotité

salarié . convention collective . presse magazine . barème:
  titre: Minimum brut à temps plein
  applicable si: convention collective = 'presse magazine'
  unité: €/mois
  variations:
    - si: groupe = 1
      alors:
        variations:
          - si: ancienneté dans l'entreprise >= 10 an
            alors: 1990.91 €/mois
          - si: ancienneté dans l'entreprise >= 6 an
            alors: 1918.51 €/mois
          - si: ancienneté dans l'entreprise >= 3 an
            alors: 1864.21 €/mois
          - sinon: 1809.92 €/mois
    - si: groupe = 2
      alors:
        variations:
          - si: ancienneté dans l'entreprise >= 10 an
            alors: 1990.91 €/mois
          - si: ancienneté dans l'entreprise >= 6 an
            alors: 1918.51 €/mois
          - si: ancienneté dans l'entreprise >= 3 an
            alors: 1864.21 €/mois
          - sinon: 1809.92 €/mois
    - si: groupe = 3
      alors:
        variations:
          - si: ancienneté dans l'entreprise >= 10 an
            alors: 2113.56 €/mois
          - si: ancienneté dans l'entreprise >= 6 an
            alors: 2036.70 €/mois
          - si: ancienneté dans l'entreprise >= 3 an
            alors: 1979.06 €/mois
          - sinon: 1921.41 €/mois
    - si: groupe = 4
      alors:
        variations:
          - si: ancienneté dans l'entreprise >= 10 an
            alors: 2259.33 €/mois
          - si: ancienneté dans l'entreprise >= 6 an
            alors: 2177.17 €/mois
          - si: ancienneté dans l'entreprise >= 3 an
            alors: 2115.55 €/mois
          - sinon: 2053.93 €/mois
    - si: groupe = 5
      alors:
        variations:
          - si: ancienneté dans l'entreprise >= 10 an
            alors: 2459.75 €/mois
          - si: ancienneté dans l'entreprise >= 6 an
            alors: 2370.30 €/mois
          - si: ancienneté dans l'entreprise >= 3 an
            alors: 2303.22 €/mois
          - sinon: 2236.13 €/mois
    - si: groupe = 6
      alors:
        variations:
          - si: ancienneté dans l'entreprise >= 10 an
            alors: 2644.22 €/mois
          - si: ancienneté dans l'entreprise >= 6 an
            alors: 2548.07 €/mois
          - si: ancienneté dans l'entreprise >= 3 an
            alors: 2475.96 €/mois
          - sinon: 2403.84 €/mois
    - si: groupe = 7
      alors:
        variations:
          - si: ancienneté dans l'entreprise >= 10 an
            alors: 2987.97 €/mois
          - si: ancienneté dans l'entreprise >= 6 an
            alors: 2879.32 €/mois
          - si: ancienneté dans l'entreprise >= 3 an
            alors: 2797.83 €/mois
          - sinon: 2716.34 €/mois
    - si: groupe = 8
      alors:
        variations:
          - si: ancienneté dans l'entreprise >= 10 an
            alors: 3483.77 €/mois
          - si: ancienneté dans l'entreprise >= 6 an
            alors: 3357.09 €/mois
          - si: ancienneté dans l'entreprise >= 3 an
            alors: 3262.08 €/mois
          - sinon: 3167.07 €/mois
    - si: groupe = 9
      alors:
        variations:
          - si: ancienneté dans l'entreprise >= 10 an
            alors: 3839.56 €/mois
          - si: ancienneté dans l'entreprise >= 6 an
            alors: 3699.94 €/mois
          - si: ancienneté dans l'entreprise >= 3 an
            alors: 3595.22 €/mois
          - sinon: 3490.51 €/mois
    - sinon: 0 €/mois

salarié . convention collective . presse magazine . groupe hors grille:
  titre: Groupe absent du barème
  applicable si: convention collective = 'presse magazine'
  valeur: barème = 0 €/mois

salarié . convention collective . presse magazine . formation professionnelle conventionnelle:
  titre: Contribution conventionnelle de formation professionnelle
  description: |
    Contribution conventionnelle mutualisée de formation professionnelle des entreprises de 11
    salariés et plus : 0,1 % des salaires de 11 à 49 salariés, 0,4 % à partir de 50, de 2026 à
    2028 (article 9 de l'accord du 8 décembre 2025), versée à l'Afdas. Le montant mensuel est
    une provision sur le brut du mois.
  applicable si: convention collective = 'presse magazine'
  unité: €/mois
  produit:
    - cotisations . assiette
    - taux

salarié . convention collective . presse magazine . formation professionnelle conventionnelle . taux:
  variations:
    - si: date < 01/01/2026
      alors: 0%
    - si: date >= 01/01/2029
      alors: 0%
    - si: entreprise . salariés . effectif >= 50
      alors: 0.4%
    - si: entreprise . salariés . effectif >= 11
      alors: 0.1%
    - sinon: 0%

salarié . convention collective . presse magazine . cotisations employeur avec formation conventionnelle:
  applicable si: convention collective = 'presse magazine'
  remplace: salarié . cotisations . employeur
  somme:
    - salarié . cotisations . employeur
    - formation professionnelle conventionnelle
