# Mareyeurs-expéditeurs (IDCC 1589).
# Version 2024.1 : salaires mensuels de la grille pour 151,67 heures, niveaux I à VIII.
validFrom: 2024-12-01
extension: 2025-03-18
sources:
  - >-
    Avenant du 29 novembre 2024 à l'annexe II de la convention collective, article 1er : grille à compter du 1er décembre 2024 (de 11,91 € à 22,37 € de l'heure, base 151,67 heures), étendu par arrêté du 25 février 2025 (JORF du 18 mars 2025).
  - >-
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000051314709
  - >-
    Convention collective nationale des mareyeurs-expéditeurs du 15 mai 1990, conteneur KALICONT000005635209.
---
salarié . convention collective . mareyeurs expéditeurs:
  titre: Mareyeurs-expéditeurs (IDCC 1589)
  valeur: convention collective = 'mareyeurs expéditeurs'

salarié . convention collective . mareyeurs expéditeurs . niveau:
  titre: Niveau
  description: Niveau de I à VIII de la grille. Un salarié de niveau I passe au niveau II après 6 mois d'ancienneté dans l'entreprise.
  applicable si: convention collective = 'mareyeurs expéditeurs'
  par défaut: "''"

salarié . convention collective . mareyeurs expéditeurs . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Minimum brut à temps plein de la grille, proratisé selon la quotité de travail.
  applicable si: convention collective = 'mareyeurs expéditeurs'
  unité: €/mois
  valeur: grille * contrat . temps de travail . quotité

salarié . convention collective . mareyeurs expéditeurs . salaire minimum conventionnel . grille:
  titre: Minimum brut à temps plein
  unité: €/mois
  variations:
    - si: niveau = 'I'
      alors: 1806.39 €/mois
    - si: niveau = 'II'
      alors: 1821.56 €/mois
    - si: niveau = 'III'
      alors: 1848.86 €/mois
    - si: niveau = 'IV'
      alors: 1860.99 €/mois
    - si: niveau = 'V'
      alors: 1906.49 €/mois
    - si: niveau = 'VI'
      alors: 2059.68 €/mois
    - si: niveau = 'VII'
      alors: 2592.04 €/mois
    - si: niveau = 'VIII'
      alors: 3392.86 €/mois
    - sinon: 0 €/mois

salarié . convention collective . mareyeurs expéditeurs . niveau hors grille:
  titre: Niveau absent de la grille
  applicable si: convention collective = 'mareyeurs expéditeurs'
  valeur: salaire minimum conventionnel . grille = 0 €/mois
