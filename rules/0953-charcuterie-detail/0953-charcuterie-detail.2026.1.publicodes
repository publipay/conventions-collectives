# Charcuterie de détail (IDCC 953).
# Version 2026.1 : Taux horaires de l'avenant n° 64 (de 12,27 € à 20,43 €), convertis en minima mensuels.
validFrom: 2026-01-01
extension: 2026-07-23
sources:
  - >-
    Avenant n° 64 du 15 janvier 2026 relatif aux salaires au 1er janvier 2026, article 1er (salaires horaires bruts des coefficients 150 à 330), étendu par arrêté du 17 juillet 2026 (JORF du 23 juillet 2026) sous réserve du SMIC. Les taux horaires sont convertis en minima mensuels pour 151,67 heures, arrondis au centime.
  - >-
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000054553974
  - >-
    Convention collective nationale de la charcuterie de détail du 1er décembre 1977, conteneur KALICONT000005635375.
---
salarié . convention collective . charcuterie de détail:
  titre: Charcuterie de détail (IDCC 953)
  valeur: convention collective = 'charcuterie de détail'

salarié . convention collective . charcuterie de détail . coefficient:
  titre: Coefficient
  description: Coefficient de 150 à 330 de la grille.
  applicable si: convention collective = 'charcuterie de détail'
  unité: unité
  par défaut: 0

salarié . convention collective . charcuterie de détail . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Minimum brut à temps plein de la grille, proratisé selon la quotité de travail.
  applicable si: convention collective = 'charcuterie de détail'
  unité: €/mois
  valeur: grille * contrat . temps de travail . quotité

salarié . convention collective . charcuterie de détail . salaire minimum conventionnel . grille:
  titre: Minimum brut à temps plein
  unité: €/mois
  variations:
    - si: coefficient = 150
      alors: 1860.99 €/mois
    - si: coefficient = 160
      alors: 1885.26 €/mois
    - si: coefficient = 170
      alors: 1906.49 €/mois
    - si: coefficient = 180
      alors: 1962.61 €/mois
    - si: coefficient = 190
      alors: 2042.99 €/mois
    - si: coefficient = 200
      alors: 2114.28 €/mois
    - si: coefficient = 210
      alors: 2153.71 €/mois
    - si: coefficient = 220
      alors: 2220.45 €/mois
    - si: coefficient = 230
      alors: 2294.77 €/mois
    - si: coefficient = 240
      alors: 2370.60 €/mois
    - si: coefficient = 260
      alors: 2522.27 €/mois
    - si: coefficient = 300
      alors: 2872.63 €/mois
    - si: coefficient = 330
      alors: 3098.62 €/mois
    - sinon: 0 €/mois

salarié . convention collective . charcuterie de détail . coefficient hors grille:
  titre: Classification absente de la grille
  applicable si: convention collective = 'charcuterie de détail'
  valeur: salaire minimum conventionnel . grille = 0 €/mois
