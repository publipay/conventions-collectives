# Professions de la photographie (IDCC 3168).
# Version 2024.1 : Salaires minima mensuels de l'avenant du 15 février 2024 ; les premiers coefficients sont sous le SMIC de 2026.
validFrom: 2024-03-01
extension: 2024-06-01
sources:
  - >-
    Avenant du 15 février 2024 relatif aux salaires minima, article 1er (salaires minima mensuels bruts pour 151,67 heures, coefficients 150 à 450), applicable le 1er mars 2024 aux entreprises adhérentes aux organisations signataires et, pour les autres, le premier jour du mois suivant la publication de l'arrêté d'extension (arrêté du 13 mai 2024, JORF du 31 mai 2024), soit le 1er juin 2024. Aucun accord de salaires postérieur n'est publié sur Légifrance au 2 novembre 2026.
  - >-
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000049605869
  - >-
    Convention collective nationale des professions de la photographie du 13 février 2013, conteneur KALICONT000027961162.
---
salarié . convention collective . photographie:
  titre: Professions de la photographie (IDCC 3168)
  valeur: convention collective = 'photographie'

salarié . convention collective . photographie . coefficient:
  titre: Coefficient
  description: Coefficient de 150 à 450 de la grille.
  applicable si: convention collective = 'photographie'
  unité: unité
  par défaut: 0

salarié . convention collective . photographie . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Minimum brut à temps plein de la grille, proratisé selon la quotité de travail.
  applicable si: convention collective = 'photographie'
  unité: €/mois
  valeur: grille * contrat . temps de travail . quotité

salarié . convention collective . photographie . salaire minimum conventionnel . grille:
  titre: Minimum brut à temps plein
  unité: €/mois
  variations:
    - si: coefficient = 150
      alors: 1767 €/mois
    - si: coefficient = 155
      alors: 1803 €/mois
    - si: coefficient = 165
      alors: 1823 €/mois
    - si: coefficient = 175
      alors: 1845 €/mois
    - si: coefficient = 185
      alors: 1865 €/mois
    - si: coefficient = 195
      alors: 1944 €/mois
    - si: coefficient = 205
      alors: 2022 €/mois
    - si: coefficient = 210
      alors: 2125 €/mois
    - si: coefficient = 220
      alors: 2228 €/mois
    - si: coefficient = 230
      alors: 2326 €/mois
    - si: coefficient = 250
      alors: 2521 €/mois
    - si: coefficient = 270
      alors: 2636 €/mois
    - si: coefficient = 275
      alors: 2752 €/mois
    - si: coefficient = 320
      alors: 3035 €/mois
    - si: coefficient = 350
      alors: 3363 €/mois
    - si: coefficient = 370
      alors: 3605 €/mois
    - si: coefficient = 410
      alors: 4021 €/mois
    - si: coefficient = 450
      alors: 4393 €/mois
    - sinon: 0 €/mois

salarié . convention collective . photographie . coefficient hors grille:
  titre: Classification absente de la grille
  applicable si: convention collective = 'photographie'
  valeur: salaire minimum conventionnel . grille = 0 €/mois
