# Industries et commerce de la récupération (IDCC 637).
# Version 2026.1 : Barème des salaires minima conventionnels au 1er janvier 2026.
# Révision 2026.2 : ajoute à la version 2026.1, à dates d'effet identiques, la contribution au
# financement du dialogue social (0,06 % de la masse salariale brute).
validFrom: 2026-01-01
extension: 2026-01-17
sources:
  - >-
    Accord du 3 octobre 2025 relatif aux salaires au 1er janvier 2026, annexe 1 (barème des salaires minima conventionnels, base 151,67 heures, niveaux I à VII, colonnes A à C), étendu par arrêté du 13 janvier 2026 (JORF du 17 janvier 2026). Tableau lu sur Légifrance le 2 novembre 2026 (la colonne D est vide).
  - >-
    https://www.legifrance.gouv.fr/conv_coll/article/KALIARTI000053497305
  - >-
    Convention collective nationale des industries et du commerce de la récupération du 6 décembre 1971, conteneur KALICONT000005635466.
  - >-
    Avenant du 3 octobre 2024 à l'accord du 6 décembre 2017 relatif au financement du dialogue
    social (KALITEXT000050974559), étendu par arrêté du 6 février 2025 (JORF du 21 février 2025)
    : paragraphe 1.1 de l'accord, contribution à la charge des employeurs calculée sur la masse
    salariale brute de l'année civile précédente, dont le taux « est donc revalorisé et fixé à
    0,06 % au lieu de 0,05 % ». Texte lu sur Légifrance le 8 novembre 2026 :
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000050974559
---
salarié . convention collective . récupération:
  titre: Industries et commerce de la récupération (IDCC 637)
  valeur: convention collective = 'récupération'

salarié . convention collective . récupération . niveau:
  titre: Niveau et échelon
  description: >-
    Niveau I à VII et échelon A, B ou C (par exemple IV.B).
  applicable si: convention collective = 'récupération'
  par défaut: "'non renseigné'"

salarié . convention collective . récupération . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Minimum brut à temps plein de la grille, proratisé selon la quotité de travail.
  applicable si: convention collective = 'récupération'
  unité: €/mois
  valeur: grille * contrat . temps de travail . quotité

salarié . convention collective . récupération . salaire minimum conventionnel . grille:
  titre: Minimum brut à temps plein
  unité: €/mois
  variations:
    - si: niveau = 'I.A'
      alors: 1910.42 €/mois
    - si: niveau = 'I.B'
      alors: 1916.90 €/mois
    - si: niveau = 'I.C'
      alors: 1929.94 €/mois
    - si: niveau = 'II.A'
      alors: 1943.02 €/mois
    - si: niveau = 'II.B'
      alors: 1956.07 €/mois
    - si: niveau = 'II.C'
      alors: 1975.66 €/mois
    - si: niveau = 'III.A'
      alors: 1986.89 €/mois
    - si: niveau = 'III.B'
      alors: 2017.66 €/mois
    - si: niveau = 'III.C'
      alors: 2070.58 €/mois
    - si: niveau = 'IV.A'
      alors: 2114.69 €/mois
    - si: niveau = 'IV.B'
      alors: 2177.47 €/mois
    - si: niveau = 'IV.C'
      alors: 2242.06 €/mois
    - si: niveau = 'V.A'
      alors: 2332.68 €/mois
    - si: niveau = 'V.B'
      alors: 2462 €/mois
    - si: niveau = 'V.C'
      alors: 2591.35 €/mois
    - si: niveau = 'VI.A'
      alors: 2701.57 €/mois
    - si: niveau = 'VI.B'
      alors: 2914.63 €/mois
    - si: niveau = 'VI.C'
      alors: 3386.73 €/mois
    - si: niveau = 'VII.A'
      alors: 3509.23 €/mois
    - si: niveau = 'VII.B'
      alors: 3649.38 €/mois
    - si: niveau = 'VII.C'
      alors: 3815.02 €/mois
    - sinon: 0 €/mois

salarié . convention collective . récupération . niveau hors grille:
  titre: Classification absente de la grille
  applicable si: convention collective = 'récupération'
  valeur: salaire minimum conventionnel . grille = 0 €/mois

salarié . convention collective . récupération . financement du paritarisme:
  titre: Contribution au financement du dialogue social
  description: |
    Contribution des employeurs au financement du dialogue social : 0,06 % de la masse salariale
    brute (paragraphe 1.1 de l'accord du 6 décembre 2017, modifié par l'avenant du 3 octobre
    2024). Le montant mensuel est une provision : 0,06 % du brut du mois.
  applicable si: convention collective = 'récupération'
  unité: €/mois
  produit:
    - cotisations . assiette
    - 0.06%

salarié . convention collective . récupération . cotisations employeur avec paritarisme:
  applicable si: convention collective = 'récupération'
  remplace: salarié . cotisations . employeur
  somme:
    - salarié . cotisations . employeur
    - financement du paritarisme
