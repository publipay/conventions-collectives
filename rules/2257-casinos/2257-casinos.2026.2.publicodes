    - si: indice = 135
      alors: 1959 €/mois
    - si: indice = 140
      alors: 2031 €/mois
    - si: indice = 155
      alors: 2252 €/mois
    - si: indice = 175
      alors: 2567 €/mois
    - si: indice = 205
      alors: 2989 €/mois
    - si: indice = 230
      alors: 3326 €/mois
    - sinon: 0 €/mois

salarié . convention collective . casinos . grille . restauration-hôtellerie:
  unité: €/mois
  variations:
    - si: indice = 100
      alors: 1850 €/mois
    - si: indice = 105
      alors: 1860 €/mois
    - si: indice = 110
      alors: 1870 €/mois
    - si: indice = 115
      alors: 1880 €/mois
    - si: indice = 120
      alors: 1896 €/mois
    - si: indice = 130
      alors: 1916 €/mois
    - si: indice = 140
      alors: 2031 €/mois
    - si: indice = 155
      alors: 2252 €/mois
