# Convention collective nationale des casinos du 29 mars 2002 (IDCC 2257).
# Version 2026.1 : avenant n° 25 du 7 janvier 2026, étendu le 10 mars 2026 (JORF 18 mars 2026), applicable au 1er avril 2026.
# Version 2026.2 : remplace 2026.1 (même validFrom), qui ne couvrait que les jeux traditionnels. Elle
# ajoute les deux autres grilles de l'avenant n° 40 du 7 janvier 2026 (KALITEXT000054040478, étendu par
# arrêté du 10 mars 2026, JORF du 18 mars 2026) : annexe 1 (machines à sous, accueil, gestion, technique,
# spectacle) et annexe 2 (restauration-hôtellerie). La filière se choisit avec `filière` (par défaut :
# jeux traditionnels, comme 2026.1).
validFrom: 2026-04-01
sources:
  - >-
    Avenant n° 25 du 7 janvier 2026 à l'accord du 23 décembre 1996 relatif aux
    rémunérations minimales mensuelles du personnel des jeux traditionnels,
    Légifrance KALITEXT000054040443, BO 2026-6, étendu par arrêté du 10 mars 2026,
    JORF du 18 mars 2026 ; l'article 3 fixe l'effet au premier jour du mois qui
    suit la publication de l'arrêté d'extension, soit le 1er avril 2026.
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000054040443
  - >-
    Convention collective nationale des casinos du 29 mars 2002, étendue par
    arrêté du 2 avril 2003, conteneur Légifrance KALICONT000005635618.
  - >-
    Avenant n° 40 du 7 janvier 2026 relatif aux rémunérations minimales mensuelles, annexe 1 (machines à
    sous, accueil, gestion, technique et spectacle : indices 100 à 230) et annexe 2 (restauration-hôtellerie :
    indices 100 à 230), article d'effet : premier jour du mois suivant la publication de l'arrêté d'extension
    (JORF du 18 mars 2026), soit le 1er avril 2026. Annexe 1 lue sur Légifrance le 1er novembre 2026 ;
    les montants de l'annexe 2, identiques à ceux de l'annexe 1 aux indices communs, viennent de la liste des
    indices de l'annexe (100, 105, 110, 115, 120, 130, 140, 155, 175, 205, 230).
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000054040478

---
salarié . convention collective . casinos:
  titre: Casinos (IDCC 2257)
  valeur: convention collective = 'casinos'
  description: >-
    Minima mensuels bruts à temps complet de trois grilles : jeux traditionnels (avenant n° 25 du 7 janvier
    2026), machines à sous, accueil, gestion, technique et spectacle (avenant n° 40, annexe 1) et
    restauration-hôtellerie (avenant n° 40, annexe 2). La grille se choisit avec `filière`.

salarié . convention collective . casinos . filière:
  titre: Filière conventionnelle
  question: Quelle grille s'applique au salarié ?
  applicable si: convention collective = 'casinos'
  par défaut: "'jeux traditionnels'"
  description: >-
    `jeux traditionnels`, `machines à sous et autres filières` (machines à sous, accueil, gestion, technique,
    spectacle) ou `restauration-hôtellerie`.

salarié . convention collective . casinos . indice:
  titre: Indice de classification
  question: Quel est l'indice conventionnel ?
  unité: unité
  applicable si: convention collective = 'casinos'
  par défaut: 0

salarié . convention collective . casinos . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Minimum mensuel brut à temps complet, proratisé selon la quotité de travail.
  unité: €/mois
  applicable si: convention collective = 'casinos'
  produit:
    - grille
    - contrat . temps de travail . quotité

salarié . convention collective . casinos . grille:
  titre: Salaire minimum mensuel à temps complet
  unité: €/mois
  variations:
    - si: filière = 'machines à sous et autres filières'
      alors: grille . machines à sous
    - si: filière = 'restauration-hôtellerie'
      alors: grille . restauration-hôtellerie
    - sinon: grille . jeux traditionnels

salarié . convention collective . casinos . grille . jeux traditionnels:
  unité: €/mois
  variations:
    - si: indice = 100
      alors: 1850 €/mois
    - si: indice = 105
      alors: 1860 €/mois
    - si: indice = 110
      alors: 1870 €/mois
    - si: indice = 120
      alors: 1896 €/mois
    - si: indice = 130
      alors: 1916 €/mois
    - si: indice = 140
      alors: 2031 €/mois
    - si: indice = 150
      alors: 2176 €/mois
    - si: indice = 160
      alors: 2321 €/mois
    - si: indice = 170
      alors: 2467 €/mois
    - si: indice = 175
      alors: 2567 €/mois
    - si: indice = 180
      alors: 2630 €/mois
    - si: indice = 190
      alors: 2768 €/mois
    - si: indice = 200
      alors: 2935 €/mois
    - sinon: 0 €/mois

salarié . convention collective . casinos . grille . machines à sous:
  unité: €/mois
  variations:
    - si: indice = 100
      alors: 1850 €/mois
    - si: indice = 105
      alors: 1860 €/mois
    - si: indice = 110
      alors: 1870 €/mois
    - si: indice = 115
      alors: 1880 €/mois
    - si: indice = 120
      alors: 1896 €/mois
    - si: indice = 130
