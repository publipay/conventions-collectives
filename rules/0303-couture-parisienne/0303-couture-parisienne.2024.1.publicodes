# Couture parisienne et autres métiers de la mode (IDCC 303).
# Version 2024.1 : Rémunérations minimales annuelles garanties de l'annexe 16 (avenant n° 18 du 2 avril 2024).
validFrom: 2024-01-01
extension: 2024-06-20
sources:
  - >-
    Avenant n° 18 du 2 avril 2024 à l'accord du 25 janvier 2002 relatif aux rémunérations minimales annuelles garanties (annexe 16 : groupes 1 à 9, niveaux A à C, base 35 heures par semaine et 1 600 heures par an), applicable à compter du 1er janvier 2024 (article 2), étendu par arrêté du 14 juin 2024 (JORF du 20 juin 2024). Tableau lu sur Légifrance le 2 novembre 2026 : les groupes 7 à 9 n'ont pas de niveau A.
  - >-
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000049756101
  - >-
    Convention collective nationale de la couture parisienne et des autres métiers de la mode, conteneur KALICONT000005635552.
---
salarié . convention collective . couture parisienne:
  titre: Couture parisienne et autres métiers de la mode (IDCC 303)
  valeur: convention collective = 'couture parisienne'

salarié . convention collective . couture parisienne . niveau:
  titre: Groupe et niveau
  description: >-
    Groupe 1 à 9 et niveau A, B ou C de l'annexe 16 (par exemple 3.B) ; les groupes 7 à 9 n'ont que les niveaux B et C.
  applicable si: convention collective = 'couture parisienne'
  par défaut: "'non renseigné'"

salarié . convention collective . couture parisienne . salaire minimum annuel conventionnel:
  titre: Salaire minimum annuel conventionnel
  description: Minimum brut à temps plein de la grille, proratisé selon la quotité de travail.
  applicable si: convention collective = 'couture parisienne'
  unité: €/an
  valeur: grille * contrat . temps de travail . quotité

salarié . convention collective . couture parisienne . salaire minimum annuel conventionnel . grille:
  titre: Minimum brut à temps plein
  unité: €/an
  variations:
    - si: niveau = '1.A'
      alors: 21801 €/an
    - si: niveau = '1.B'
      alors: 22130 €/an
    - si: niveau = '1.C'
      alors: 22506 €/an
    - si: niveau = '2.A'
      alors: 22506 €/an
    - si: niveau = '2.B'
      alors: 23054 €/an
    - si: niveau = '2.C'
      alors: 26382 €/an
    - si: niveau = '3.A'
      alors: 26512 €/an
    - si: niveau = '3.B'
      alors: 27755 €/an
    - si: niveau = '3.C'
      alors: 31763 €/an
    - si: niveau = '4.A'
      alors: 31920 €/an
    - si: niveau = '4.B'
      alors: 33289 €/an
    - si: niveau = '4.C'
      alors: 38092 €/an
    - si: niveau = '5.A'
      alors: 38279 €/an
    - si: niveau = '5.B'
      alors: 38880 €/an
    - si: niveau = '5.C'
      alors: 44710 €/an
    - si: niveau = '6.A'
      alors: 38279 €/an
    - si: niveau = '6.B'
      alors: 44064 €/an
    - si: niveau = '6.C'
      alors: 49780 €/an
    - si: niveau = '7.B'
      alors: 50275 €/an
    - si: niveau = '7.C'
      alors: 57247 €/an
    - si: niveau = '8.B'
      alors: 57817 €/an
    - si: niveau = '8.C'
      alors: 65188 €/an
    - si: niveau = '9.B'
      alors: 65188 €/an
    - si: niveau = '9.C'
      alors: 74593 €/an
    - sinon: 0 €/an

salarié . convention collective . couture parisienne . niveau hors grille:
  titre: Classification absente de la grille
  applicable si: convention collective = 'couture parisienne'
  valeur: salaire minimum annuel conventionnel . grille = 0 €/an
